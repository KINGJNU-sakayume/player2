  "lines": {
    "7a213ed8": "도망치고 싶은 밤의 거리, 행방은 아직 불명",
    "4ba23ca6": "돌고 돌아 허무해서 곤란해졌네 멍멍멍",
    "e633de88": "잃어버린 건 없는데 뭔가 모자란 기분",
    "438d10f4": "묘하게 들떠서 밟아 댄 네 바퀴 차",
    "171985c1": "형제여, 어떻게든 해 보자",
    "d7959b85": "이제 아무것도 생각하지 않도록",
    "5adb020f": "은하계 끝자락으로, 안녕",
    "82d452df": "진실도 도덕도",
    "2b1b7354": "작동하지 않는 미쳐 버린 밤이라도",
    "1da4ac38": "우리는 손뼉 치며 함께 웃어",
    "716864fa": "아무도 모르게",
    "40f01de3": "단 한순간의 이 반짝임을",
    "f86a5203": "둘이서 남김없이 먹어 치우자, 뻗을 때까지",
    "84c9bbc7": "그리고 행운을, 우리에게 기도를",
    "0a9c322f": "더 가 보자, 아무도 따라잡지 못할 속도로",
    "4b7b54fb": "번개처럼 살고 싶을 뿐이야",
    "bdd4ed95": "너는 어떡하고 싶어?",
    "4f9a33e8": "대답은 필요 없어",
    "67b93f9e": "굴러가는 차창과 풍경, 동기는 아직 불명",
    "eb09e031": "귀찮고 짜증 나서 길 잃은 야옹야옹야옹",
    "73190af0": "이 근처에서 떨어뜨린 지갑, 누구 못 보셨어요?",
    "069a02c9": "바보처럼 운도 없네, 놀려 줘 하이웨이 스타",
    "ba60397c": "어이 파트너, 한 판 더",
    "bc60e182": "만화 같은 싸움 한번 하자",
    "2bd42366": "농담으로 안 끝날 만한 걸로, 시험 삼아",
    "d9473ff4": "바른말과 막말의",
    "0a36704b": "구분조차 안 되는 거리를",
    "bc671a2b": "빠져나와 서로 마주 보고 웃어",
    "7fccc084": "노리는 건 달콤한 엔딩",
    "cbe5f82e": "그건 심장을 찰나에 뒤흔드는 것",
    "0180122c": "쫓아가는 순간 놓쳐 버리는 것",
    "09e945a7": "분명 영원이 어딘가에 있을 거라며",
    "5952f4d9": "엉뚱한 모레를 찾아 헤매는 것도 나쁘지 않잖아",
    "9a07db10": "네가 어딘가로 사라진 아침보다",
    "14df6a8c": "이런 밤이",
    "a5562b8f": "아직 나아",
    "56c7d5e4": "폐에는 수련, 멀리서 사이렌",
    "b8c50f36": "함께 울리는 경계선",
    "01b729c9": "사랑하듯이 싸워 보자고",
    "355b529b": "어쩔 줄 모를 서글픔을 끌어안고"
  },

  "lines": {
    "e7c509ff": "일그러지고 상처투성이인 봄",
    "cfab1cb1": "마취도 하지 않고 걸었어",
    "6747830d": "몸 깊은 곳에서 울려",
    "1bab7a5c": "아직 덜 살았다고, 강하게",
    "ced216de": "아직 맛볼 거야, 다 씹은 껌의 맛을",
    "e7f5c5ca": "다 식지 못한 마음으로",
    "8b78841b": "하나씩 잃어버린 끝에",
    "3616fff5": "겨우 남은 것",
    "a2577429": "이게 사랑이 아니라면 뭐라고 불러야 할까",
    "7f9feb92": "나는 몰랐어",
    "a47a22e3": "불러, 꽃의 이름을 단 하나만",
    "c76ec3b5": "터질 듯이",
    "e6e98d46": "코끝이 닿아, 숨이 멎어",
    "f2c8bb97": "아픔은 사라지지 않은 채여도 좋아",
    "80ea8cbd": "지친 그 눈으로 무슨 말을 해",
    "e7463708": "흉터를 감추고 걸었어",
    "b29bfdd7": "그러면서도 그림자는 흩뿌렸지",
    "49af2a47": "알아주길 바랐어",
    "99376cd6": "아직 걸을 수 있을까, 곱씹은 모래의 맛",
    "429dcde6": "밤이슬에 젖은 잔디 위",
    "3c65df74": "들뜬 가슴에 묻는 말",
    "66ce6a05": "끝내기엔 아직 이르잖아",
    "d242e9e9": "아무도 슬퍼하지 않도록 미소 짓는 일이",
    "9224f69e": "잘되지 않았어",
    "198e268c": "하나, 단 하나면 돼, 지킬 수만 있다면",
    "cbe0659d": "그걸로 충분했는데",
    "061fca78": "너무나 하찮은 소원이 사라지지 않아",
    "40e32e3c": "누구도 빼앗을 수 없는 영혼",
    "8dd62610": "무엇에 비유할까, 너와 나를",
    "841aefe7": "발뒤꿈치에 남은 닮은 상처를",
    "815893b9": "갠 하늘을 이어 가면 아직 계속돼",
    "4d82af7e": "가자 (가자)",
    "c04f4667": "꽃도 피기 전에",
    "8e7a2bb9": "불러, 두려운 그대로 꽃의 이름을",
    "5a58249d": "너 아니면 안 된다고",
    "03d5676f": "그치지 않아",
    "f6d6ca64": "갠 하늘을 이어 가면 아직 계속돼, 가자 (가자)"

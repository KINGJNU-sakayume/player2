  "segments": [
    {
      "startMs": 0,
      "endMs": 5330,
      "translation": "그녀가 충분히 내 것이라는 느낌이 안 들어"
    },
    {
      "startMs": 5330,
      "endMs": 10900,
      "translation": "신이여, 너를 끝까지 붙잡을 수 없을 것 같아"
    },
    {
      "startMs": 10900,
      "endMs": 12560,
      "translation": "손목 위의 나비"
    },
    {
      "startMs": 12560,
      "endMs": 17220,
      "translation": "넌 내 살결 위에 예쁜 여자들을 그려 내"
    },
    {
      "startMs": 17220,
      "endMs": 21530,
      "translation": "그리고 난 그런 기분이 아니야"
    },
    {
      "startMs": 21530,
      "endMs": 25940,
      "translation": "그리고 넌 떠나지 않을 걸 알아"
    },
    {
      "startMs": 25940,
      "endMs": 28510,
      "translation": "다들 \"네 걸 직접 세워 봐\"라고 하지, 난 \"어떻게, 스웨이?\"라고 했어"
    },
    {
      "startMs": 28510,
      "endMs": 31400,
      "translation": "난 \"노예제는 선택이었다\"고 했고, 다들 \"어떻게, 이?\"라고 했지"
    },
    {
      "startMs": 31400,
      "endMs": 34390,
      "translation": "내가 거칠게 나가는 날 걸렸다면 어땠을지 상상해 봐"
    },
    {
      "startMs": 34390,
      "endMs": 37120,
      "translation": "이제 난 블로그 오십 곳에 오르고 전화를 오십 통 받아"
    },
    {
      "startMs": 37120,
      "endMs": 40520,
      "translation": "아내가 전화해서 소리쳐, 우리 다 잃게 생겼다고"
    },
    {
      "startMs": 40520,
      "endMs": 43120,
      "translation": "숨을 못 쉬어서 진정시켜야 했지"
    },
    {
      "startMs": 43120,
      "endMs": 45000,
      "translation": "이제 떠나도 된다고 했지만, 그녀는 떠나지 않았어"
    },
    {
      "startMs": 45000,
      "endMs": 46460,
      "translation": "그리고 넌 떠나지 않을 걸 알아"
    },
    {
      "startMs": 46460,
      "endMs": 49700,
      "translation": "그리고 가끔은 바라"
    },
    {
      "startMs": 49700,
      "endMs": 52270,
      "translation": "우리가 이런 걸 하고 있다는 걸"
    },
    {
      "startMs": 52270,
      "endMs": 55600,
      "translation": "우린 이보다 더 오래 기다릴 수 있어"
    },
    {
      "startMs": 55600,
      "endMs": 58210,
      "translation": "그래, 넌 그런 사람 중 하나라는 걸 알잖아"
    },
    {
      "startMs": 58210,
      "endMs": 62160,
      "translation": "지붕을 연 차로 달릴 수 있어, 그래"
    },
    {
      "startMs": 62160,
      "endMs": 68410,
      "translation": "선드레스를 늘어뜨린 채, 우"
    },
    {
      "startMs": 68410,
      "endMs": 70960,
      "translation": "그리고 넌 그러지 않을 걸 알아"
    },
    {
      "startMs": 70960,
      "endMs": 73700,
      "translation": "오, 그 얘긴 꺼내지 마, 감상적으로 되잖아"
    },
    {
      "startMs": 73700,
      "endMs": 76430,
      "translation": "알잖아, 난 예민하고 마음이 여려"
    },
    {
      "startMs": 76430,
      "endMs": 79610,
      "translation": "무슨 일만 생기면 다들 날 정신병원에 보내려 해"
    },
    {
      "startMs": 79610,
      "endMs": 82490,
      "translation": "사고가 있었지만 부대 비용은 내가 다 대"
    },
    {
      "startMs": 82490,
      "endMs": 84660,
      "translation": "넌 내가 메시지를 다듬길 바라지"
    },
    {
      "startMs": 84660,
      "endMs": 86490,
      "translation": "난 조지 젯슨처럼 미래를 생각하는데"
    },
    {
      "startMs": 86490,
      "endMs": 88480,
      "translation": "들리기는 조지 제퍼슨처럼 들려"
    },
    {
      "startMs": 88480,
      "endMs": 90530,
      "translation": "그러면 다들 내 방식을 의심하지"
    },
    {
      "startMs": 90530,
      "endMs": 92330,
      "translation": "네가 또 내 문자에 예민하게 굴면"
    },
    {
      "startMs": 92330,
      "endMs": 94170,
      "translation": "여긴 신호가 안 잡혀"
    },
    {
      "startMs": 94170,
      "endMs": 97120,
      "translation": "우릴 성층권 너머로 데려갈 마음가짐이 있어"
    },
    {
      "startMs": 97120,
      "endMs": 100010,
      "translation": "우릴 여기까지 데려온 그 태도를 그대로 써"
    },
    {
      "startMs": 100010,
      "endMs": 102930,
      "translation": "난 지금을 살아, 이다음에 무슨 일이 생길지 몰라"
    },
    {
      "startMs": 102930,
      "endMs": 105990,
      "translation": "난 지금을 살아, 이다음에 무슨 일이 생길지 몰라"
    },
    {
      "startMs": 105990,
      "endMs": 108980,
      "translation": "게다가 될 일은 될 일이었어"
    },
    {
      "startMs": 108980,
      "endMs": 111570,
      "translation": "사람들 앞에서 공감이 부족해 보여도"
    },
    {
      "startMs": 111570,
      "endMs": 114500,
      "translation": "그 얘긴 안 할 거야, 또 4세기 동안은"
    },
    {
      "startMs": 114500,
      "endMs": 115240,
      "translation": "하나 더하기 하나는 둘, 하지만 너와 나는 무한대"
    },
    {
      "startMs": 115240,
      "endMs": 122430,
      "translation": "그리고 넌 그러지 않을 걸 알아. 그녀가 충분히 내 것이라는 느낌이 안 들어"
    },
    {
      "startMs": 122430,
      "endMs": 124520,
      "translation": "신이여, 너를 끝까지 붙잡을 수 없을 것 같아"
    },
    {
      "startMs": 124520,
      "endMs": 129640,
      "translation": "왜? 손목 위의 나비"
    },
    {
      "startMs": 129640,
      "endMs": 131510,
      "translation": "넌 내 살결 위에 예쁜 여자들을 그려 내"
    },
    {
      "startMs": 131510,
      "endMs": 135910,
      "translation": "내 살결 위에, 그리고 난 그런 기분이 아니야"
    },
    {
      "startMs": 135910,
      "endMs": 138660,
      "translation": "으음"
    },
    {
      "startMs": 138660,
      "endMs": 141650,
      "translation": "그리고 넌 떠나지 않을 걸 알아"
    },
    {
      "startMs": 141650,
      "endMs": 143880,
      "translation": "(날 사랑하든 미워하든) 실수했던 모든 남자에게"
    },
    {
      "startMs": 143880,
      "endMs": 148080,
      "translation": "(날 사랑하든 미워하든) 자기 여자를 창피하게 만든 적 있는"
    },
    {
      "startMs": 148080,
      "endMs": 153990,
      "translation": "자기 아내를 창피하게 만든 적 있는 (네가 그리워할 땐 이미 떠났지) 그녀가 그러지 말라고 했잖아, 오, 그러다 돈 다 날린다고 했잖아"
    },
    {
      "startMs": 153990,
      "endMs": 155550,
      "translation": "그 기세 그대로 가"
    },
    {
      "startMs": 155550,
      "endMs": 156870,
      "translation": "그런데 넌 듣고 싶지 않았지?"
    },
    {
      "startMs": 156870,
      "endMs": 159830,
      "translation": "그 기세 그대로 가"
    },
    {
      "startMs": 159830,
      "endMs": 161560,
      "translation": "그 기세 그대로 가"
    },
    {
      "startMs": 161560,
      "endMs": 165840,
      "translation": "이제 넌 그녀의 의리를 시험하고 있어"
    },
    {
      "startMs": 165840,
      "endMs": 172190,
      "translation": "'좋을 때나 나쁠 때나'라는 말이 바로 이런 뜻이지?"
    },
    {
      "startMs": 172190,
      "endMs": 175750,
      "translation": "자기 남자 곁을 지킨 모든 여자에게"
    },
    {
      "startMs": 175750,
      "endMs": 185490,
      "translation": "가장 좋은 때에도, 가장 나쁜 때에도, 이건 너를 위한 거야"
    },
    {
      "startMs": 185490,
      "endMs": 206000,
      "translation": "그리고 넌 떠나지 않을 걸 알아"
    }
  ]
}

  "segments": [
    {
      "startMs": 280,
      "endMs": 6740,
      "translation": "쓰러지고, 꿈꾸고, 잠꼬대를 하지"
    },
    {
      "startMs": 6740,
      "endMs": 16180,
      "translation": "밤새 울고 싶은 거 알아, 밤새도록"
    },
    {
      "startMs": 16180,
      "endMs": 23740,
      "translation": "꾸미고, 계략을 짜고, 찾아내지"
    },
    {
      "startMs": 23740,
      "endMs": 29140,
      "translation": "너의 그 폭력적인 밤들을 변호할 이유를"
    },
    {
      "startMs": 29140,
      "endMs": 39090,
      "translation": "약속해 줘, 알게 될 거라고"
    },
    {
      "startMs": 39090,
      "endMs": 43290,
      "translation": "너무 서둘러 크지 마, 엄마가 걱정할 거야, 아"
    },
    {
      "startMs": 43290,
      "endMs": 47650,
      "translation": "그것도 다 이야기의 일부였어, 무서웠던 밤들까지도"
    },
    {
      "startMs": 47650,
      "endMs": 51940,
      "translation": "그 모든 영광에 고마워, 넌 기억될 거야, 아"
    },
    {
      "startMs": 51940,
      "endMs": 56610,
      "translation": "밤의 영웅들 모두에게 고마워 (밤, 밤)"
    },
    {
      "startMs": 56610,
      "endMs": 60730,
      "translation": "색을 다시 칠해야 해, 거짓말이 벗겨지고 있어"
    },
    {
      "startMs": 60730,
      "endMs": 65860,
      "translation": "현실이 닥쳤어, 색이 흘러내려"
    },
    {
      "startMs": 65860,
      "endMs": 68350,
      "translation": "색이 흘러내려"
    },
    {
      "startMs": 68350,
      "endMs": 72250,
      "translation": "남자들은 야만적이고, 남자들은 괴물이야"
    },
    {
      "startMs": 72250,
      "endMs": 74710,
      "translation": "남자들은 포주고, 남자들은 바람둥이지"
    },
    {
      "startMs": 74710,
      "endMs": 77660,
      "translation": "딸을 갖기 전까진, 그제야 조심하게 돼"
    },
    {
      "startMs": 77660,
      "endMs": 80710,
      "translation": "아버지, 용서해 주세요, 업보가 두려워요"
    },
    {
      "startMs": 80710,
      "endMs": 83390,
      "translation": "이제 난 여자를 돌봐야 할 존재로 보니까"
    },
    {
      "startMs": 83390,
      "endMs": 85160,
      "translation": "정복할 대상이 아니라"
    },
    {
      "startMs": 85160,
      "endMs": 87780,
      "translation": "그 애가 니키를 닮았으면 해, 괴물로 키울 거야"
    },
    {
      "startMs": 87780,
      "endMs": 90670,
      "translation": "셋이서 노는 건 빼고, 그냥 농담이야"
    },
    {
      "startMs": 90670,
      "endMs": 93420,
      "translation": "윌 스미스와 마틴처럼 문을 열었지"
    },
    {
      "startMs": 93420,
      "endMs": 95220,
      "translation": "이봐, 우리 문제 있어?"
    },
    {
      "startMs": 95220,
      "endMs": 98270,
      "translation": "사실, 말런, 이건 『미트 페어런츠』가 아니야"
    },
    {
      "startMs": 98270,
      "endMs": 100760,
      "translation": "그 녀석을 두들겨 패고 무죄가 나오길 기도할 거야"
    },
    {
      "startMs": 100760,
      "endMs": 104240,
      "translation": "아니, 아빠는 장난 안 쳐, 딸 문제라면"
    },
    {
      "startMs": 104240,
      "endMs": 106060,
      "translation": "요가도 하지 마, 필라테스도 하지 마"
    },
    {
      "startMs": 106060,
      "endMs": 108110,
      "translation": "그냥 피아노 치고 가라테나 해"
    },
    {
      "startMs": 108110,
      "endMs": 110460,
      "translation": "네 몸이 나를 닮았으면 하고 기도해"
    },
    {
      "startMs": 110460,
      "endMs": 111680,
      "translation": "엄마를 닮지 말고"
    },
    {
      "startMs": 111680,
      "endMs": 113860,
      "translation": "그냥 심술이야, 하지만 남자들은 제정신이 아니야"
    },
    {
      "startMs": 113860,
      "endMs": 115950,
      "translation": "나도 그런 남자니까, 그들이 뭘 원하는지 알아"
    },
    {
      "startMs": 115950,
      "endMs": 117930,
      "translation": "네가 그걸 한꺼번에 다 겪지 않기를 기도해"
    },
    {
      "startMs": 117930,
      "endMs": 121740,
      "translation": "드레스 아래 곡선, 인터넷엔 변태들이 가득하지"
    },
    {
      "startMs": 121740,
      "endMs": 123900,
      "translation": "댓글마다 다, 토하고 싶어지지"
    },
    {
      "startMs": 123900,
      "endMs": 126180,
      "translation": "네 아기잖아, 죽도록 사랑하잖아"
    },
    {
      "startMs": 126180,
      "endMs": 128340,
      "translation": "이제 그 애는 수업을 빼먹고 친구들과 어울려"
    },
    {
      "startMs": 128340,
      "endMs": 130590,
      "translation": "넌 유리잔을 깨며 다시 한번 말해"
    },
    {
      "startMs": 130590,
      "endMs": 132530,
      "translation": "그 애는 자기가 처한 위험을 이해 못 해"
    },
    {
      "startMs": 132530,
      "endMs": 134780,
      "translation": "네가 그 애를 때리면, 그 애는 그 남자한테 가서 살아"
    },
    {
      "startMs": 134780,
      "endMs": 136810,
      "translation": "그러면 그 남자가 그 애를 때리고, 넌 또 같은 일을 겪지"
    },
    {
      "startMs": 136810,
      "endMs": 139560,
      "translation": "그런데 악마인 네가 어떻게 죄를 꾸짖어?"
    },
    {
      "startMs": 139560,
      "endMs": 141350,
      "translation": "이 일을 뒤로할 수 있기를 기도하자"
    },
    {
      "startMs": 141350,
      "endMs": 143460,
      "translation": "맹세컨대 요즘은 정말 험한 시대야"
    },
    {
      "startMs": 143460,
      "endMs": 145420,
      "translation": "그 애에겐 흉터가 있어, 그게 기억하게 해"
    },
    {
      "startMs": 145420,
      "endMs": 147850,
      "translation": "잠옷엔 아직 피가 묻어 있어"
    },
    {
      "startMs": 147850,
      "endMs": 152030,
      "translation": "하지만 어제는 죽었어, 그래, 잠시 묵념"
    },
    {
      "startMs": 152030,
      "endMs": 155220,
      "translation": "다음엔 대학에 가고, 그다음엔 결혼식 제단에 서겠지"
    },
    {
      "startMs": 155220,
      "endMs": 159340,
      "translation": "남자들은 야만적이고, 남자들은 괴물이야, 그 애도 그걸 아니까"
    },
    {
      "startMs": 159340,
      "endMs": 165100,
      "translation": "남자들은 포주고 바람둥이지, 딸을 갖기 전까진"
    },
    {
      "startMs": 165100,
      "endMs": 169400,
      "translation": "남자들은 포주고 바람둥이지, 딸을 갖기 전까진"
    },
    {
      "startMs": 169400,
      "endMs": 174010,
      "translation": "너무 서둘러 크지 마, 엄마가 걱정할 거야, 아"
    },
    {
      "startMs": 174010,
      "endMs": 178320,
      "translation": "그것도 다 이야기의 일부였어, 무서웠던 밤들까지도"
    },
    {
      "startMs": 178320,
      "endMs": 182930,
      "translation": "그 모든 영광에 고마워, 넌 기억될 거야, 아"
    },
    {
      "startMs": 182930,
      "endMs": 187390,
      "translation": "밤의 영웅들 모두에게 고마워 (밤, 밤)"
    },
    {
      "startMs": 187390,
      "endMs": 191680,
      "translation": "색을 다시 칠해야 해, 거짓말이 벗겨지고 있어"
    },
    {
      "startMs": 191680,
      "endMs": 196770,
      "translation": "현실이 닥쳤어, 색이 흘러내려"
    },
    {
      "startMs": 196770,
      "endMs": 201650,
      "translation": "색이 흘러내려"
    },
    {
      "startMs": 201650,
      "endMs": 202800,
      "translation": "이렇게 말하는 거지…"
    },
    {
      "startMs": 202800,
      "endMs": 205630,
      "translation": "\"니키 같은 딸을 원해, 아, 이봐, 약속할게"
    },
    {
      "startMs": 205630,
      "endMs": 208840,
      "translation": "그 애를 괴물로 키울 거야, 하지만 셋이서 노는 건 없어\""
    },
    {
      "startMs": 208840,
      "endMs": 215000,
      "translation": "네가 어떻게 말하는지는 모르겠지만, 이걸 들려줘"
    }
  ]
}

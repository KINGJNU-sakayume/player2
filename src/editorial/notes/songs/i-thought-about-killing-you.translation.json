  "segments": [
    {
      "startMs": 550,
      "endMs": 8410,
      "translation": "알아, 알아, 알아, 알아, 알아"
    },
    {
      "startMs": 8410,
      "endMs": 8820,
      "translation": "나, 난 알아, 알아"
    },
    {
      "startMs": 8820,
      "endMs": 17260,
      "translation": "알아, 알아, 알아, 알아, 알아"
    },
    {
      "startMs": 17260,
      "endMs": 25070,
      "translation": "가장 아름다운 생각은 언제나 가장 어두운 생각 바로 옆에 있어"
    },
    {
      "startMs": 25070,
      "endMs": 27750,
      "translation": "오늘, 진지하게 널 죽일까 생각했어"
    },
    {
      "startMs": 27750,
      "endMs": 32960,
      "translation": "곰곰이 따져 봤지, 계획된 살인을"
    },
    {
      "startMs": 32960,
      "endMs": 34260,
      "translation": "그리고 나 자신을 죽일까도 생각해"
    },
    {
      "startMs": 34260,
      "endMs": 40180,
      "translation": "그리고 난 널 사랑하는 것보다 나를 훨씬 더 사랑해, 그러니"
    },
    {
      "startMs": 40180,
      "endMs": 48310,
      "translation": "오늘, 널 죽일까 생각했어, 계획된 살인"
    },
    {
      "startMs": 48310,
      "endMs": 52740,
      "translation": "사랑하는 사람이어야 죽일 만큼 신경을 쓰지"
    },
    {
      "startMs": 52740,
      "endMs": 56090,
      "translation": "가장 아름다운 생각은 언제나 가장 어두운 생각 바로 옆에 있어"
    },
    {
      "startMs": 56090,
      "endMs": 59980,
      "translation": "음, 음, 음, 음, 음"
    },
    {
      "startMs": 59980,
      "endMs": 63020,
      "translation": "그냥 소리 내어 말해 봐, 어떤 기분인지"
    },
    {
      "startMs": 63020,
      "endMs": 65070,
      "translation": "사람들은 \"이런 말 하지 마, 저런 말 하지 마\" 하지"
    },
    {
      "startMs": 65070,
      "endMs": 71350,
      "translation": "그냥 소리 내어 말해 봐, 어떤 기분인지 보려고"
    },
    {
      "startMs": 71350,
      "endMs": 74600,
      "translation": "모든 선택지를 따져 봐, 빼놓을 건 없어"
    },
    {
      "startMs": 74600,
      "endMs": 79600,
      "translation": "오늘, 널 죽일까 생각했어, 계획된 살인"
    },
    {
      "startMs": 79600,
      "endMs": 80940,
      "translation": "나 자신을 죽일까도 생각해"
    },
    {
      "startMs": 80940,
      "endMs": 84750,
      "translation": "그리고 난, 난 널 사랑하는 것보다 나를 훨씬 더 사랑해"
    },
    {
      "startMs": 84750,
      "endMs": 88060,
      "translation": "가장 아름다운 생각은 언제나 가장 어두운 생각 바로 옆에 있어"
    },
    {
      "startMs": 88060,
      "endMs": 94300,
      "translation": "음, 음, 음, 음, 음, 음, 음, 음, 음"
    },
    {
      "startMs": 94300,
      "endMs": 102300,
      "translation": "이쯤에서 나쁘게 들리지 않도록 뭔가 좋은 말로 만회해야 하는 거겠지"
    },
    {
      "startMs": 102300,
      "endMs": 104940,
      "translation": "하지만 가끔 난 정말 나쁜 생각을 해"
    },
    {
      "startMs": 104940,
      "endMs": 113230,
      "translation": "정말, 정말, 정말 나쁜 생각을"
    },
    {
      "startMs": 113230,
      "endMs": 121330,
      "translation": "그리고 난 널 사랑하는 것보다 나를 훨씬 더 사랑해"
    },
    {
      "startMs": 121330,
      "endMs": 123610,
      "translation": "봐, 더 많은 사람이 공감하게 하려 했다면"
    },
    {
      "startMs": 123610,
      "endMs": 126360,
      "translation": "아마 나 자신을 사랑하기가 힘들다고 말했겠지"
    },
    {
      "startMs": 126360,
      "endMs": 129030,
      "translation": "그게 흔한 주제처럼 보이니까"
    },
    {
      "startMs": 129030,
      "endMs": 130930,
      "translation": "하지만 여기선 그렇지 않아"
    },
    {
      "startMs": 130930,
      "endMs": 133670,
      "translation": "난 널 사랑하는 것보다 나를 훨씬 더 사랑해"
    },
    {
      "startMs": 133670,
      "endMs": 135610,
      "translation": "그리고 나 자신을 죽일까 생각해"
    },
    {
      "startMs": 135610,
      "endMs": 139350,
      "translation": "그러니 믿어도 좋아, 오늘 널 죽일까 생각했어"
    },
    {
      "startMs": 139350,
      "endMs": 140990,
      "translation": "계획된 살인"
    },
    {
      "startMs": 140990,
      "endMs": 145170,
      "translation": "사랑하는 사람들에게 전화했어, 사촌들에게도 전화했어"
    },
    {
      "startMs": 145170,
      "endMs": 149250,
      "translation": "무슬림 친구들에게도 전화해서 이제 미쳐 버릴 거라고 했지"
    },
    {
      "startMs": 149250,
      "endMs": 153280,
      "translation": "너무 밝아서 해가 없고, 너무 시끄러워서 아무것도 안 들려"
    },
    {
      "startMs": 153280,
      "endMs": 157520,
      "translation": "너무 크게 소리쳐서 폐가 없고, 너무 아파서 감각이 없어"
    },
    {
      "startMs": 157520,
      "endMs": 161550,
      "translation": "이제 드럼을 들일 시간이야, 프라-파-파-펌"
    },
    {
      "startMs": 161550,
      "endMs": 165810,
      "translation": "그들에게 뉴톤을 틀어, 그들 위로 핵을 터뜨려"
    },
    {
      "startMs": 165810,
      "endMs": 169970,
      "translation": "럼 없는 콜라가 필요해, 그녀 혀끝엔 코카인 맛이 나"
    },
    {
      "startMs": 169970,
      "endMs": 174120,
      "translation": "난 누구와도 농담 안 해, 다들 \"너무 젊어서 죽었어\"라고 하겠지"
    },
    {
      "startMs": 174120,
      "endMs": 178210,
      "translation": "나쁜 날이 너무 많은 병을 앓았었지"
    },
    {
      "startMs": 178210,
      "endMs": 182400,
      "translation": "나쁜 버릇도 너무 많아, 바닥을 재떨이로 썼지"
    },
    {
      "startMs": 182400,
      "endMs": 186510,
      "translation": "난 뭐든 대충 안 해, 캐시를 싹 비울 거야"
    },
    {
      "startMs": 186510,
      "endMs": 190660,
      "translation": "내 이름을 오래 남길 거야, 내 성을 걸고"
    },
    {
      "startMs": 190660,
      "endMs": 194710,
      "translation": "우리가 따르는 건 다른 종류의 규칙이야"
    },
    {
      "startMs": 194710,
      "endMs": 198880,
      "translation": "이, 이, 이(Ye)의 계절, 우린 올드 베이 양념이지"
    },
    {
      "startMs": 198880,
      "endMs": 203070,
      "translation": "우린 모두 죽으려고 태어났어, 도착했을 땐 이미 죽은 몸"
    },
    {
      "startMs": 203070,
      "endMs": 206680,
      "translation": "다들 영웅이라고 하지, 음, 망토는 안 보이는데"
    },
    {
      "startMs": 206680,
      "endMs": 211330,
      "translation": "음, 안 보이는데, 음, 그래, 안 보이는데, 음, 음"
    },
    {
      "startMs": 211330,
      "endMs": 216020,
      "translation": "내가 이렇게 밝게 빛나지 않았다면 그늘도 없었겠지"
    },
    {
      "startMs": 216020,
      "endMs": 219960,
      "translation": "벅위트처럼 '오-케이' 하는 녀석, 다 괜찮을 거야"
    },
    {
      "startMs": 219960,
      "endMs": 225270,
      "translation": "미안하지만 난 노예가 되지 않기로 선택했어"
    },
    {
      "startMs": 225270,
      "endMs": 229420,
      "translation": "젊은 녀석들의 방식이야, 우린 나이를 안 먹어"
    },
    {
      "startMs": 229420,
      "endMs": 233540,
      "translation": "디보처럼 굴던 시절은 다 지난 줄 알았어"
    },
    {
      "startMs": 233540,
      "endMs": 237670,
      "translation": "빈털터리가 됐을 때도 난 부서지지 않았어"
    },
    {
      "startMs": 237670,
      "endMs": 241470,
      "translation": "어떻게 날 미워해? 우린 오래된 사이잖아"
    },
    {
      "startMs": 241470,
      "endMs": 245590,
      "translation": "내가 머리를 땋고 네가 웨이브 캡을 쓰던 시절부터"
    },
    {
      "startMs": 245590,
      "endMs": 249750,
      "translation": "이발소 위치만 찍어 줘, 당장 갈게"
    },
    {
      "startMs": 249750,
      "endMs": 253870,
      "translation": "입에 한 방 맞지 마, 알잖아, 이 친구는 그런 거 안 봐줘"
    },
    {
      "startMs": 253870,
      "endMs": 258910,
      "translation": "소방서 벌금도 내, 여기 너무 꽉 찼으니까"
    },
    {
      "startMs": 258910,
      "endMs": 260970,
      "translation": "다들 내가 미쳐 날뛰는 걸 보고 싶어 해"
    },
    {
      "startMs": 260970,
      "endMs": 262520,
      "translation": "미쳐, 미쳐"
    },
    {
      "startMs": 262520,
      "endMs": 266660,
      "translation": "그저 이(Ye)에 대해 떠들기만 하면 돼"
    },
    {
      "startMs": 266660,
      "endMs": 270600,
      "translation": "그저 이(Ye)에 대해 떠들기만 하면 돼"
    },
    {
      "startMs": 270600,
      "endMs": 274000,
      "translation": "프리토레이 과자처럼 이가 깨지지 않게 조심해"
    }
  ]
}
